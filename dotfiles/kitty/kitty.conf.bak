# Force Wayland backend (required for opacity/blur on Linux)
linux_display_server wayland

# Full transparency: 0.0 = completely clear bg (shows desktop fully)
background_opacity 1

# Blur the transparent bg (1-64 radius; 10 = subtle fog) – reduced from 64 for a cleaner look
# background_blur 64
# background #1e1e24
# foreground #f0f0e5 #ebdbb2 #ffefdb
# cursor #fabd2f
# selection_foreground #655b53
# selection_background #ebdbb2
# url_color #d65c0d

# Gruvbox ANSI colors (dark variant)
# Black
# color0 #2b2b2b
# Red
# color1 #ff3019
# Green
# color2 #1adc1a
# Yellow
# color3 #ffe600
# Blue
# color4 #69b1ff
# Magenta
# color5 #ff82da
# Cyan
# color6 #0fcadb
# White (dim)
# color7 #ffefdb

# Bright Black
# color8 #928373
# Bright Red
# color9 #fb4833
# Bright Green
# color10 #ebeb2f
# Bright Yellow
# color11 #fabc2e
# Bright Blue
# color12 #83a597
# Bright Magenta
# color13 #d3859a
# Bright Cyan
# color14 #8ec07b
# Bright White
# color15 #ffffff

# Allow dynamic opacity changes (e.g., dim on unfocus)
dynamic_background_opacity no #yes

# fix washed out text?
text_fg_override_threshold 0


# BEGIN_KITTY_THEME
# GitHub Dark
include current-theme.conf
# END_KITTY_THEME